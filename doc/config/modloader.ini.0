;
;           Arquivo de Configuração de Perfis do Mod Loader
;                 Tradução PT-BR - VoxBrasil
;

[Folder.Config]

Profile = Default                 ; Perfil utilizado pelo Mod Loader para carregar e configurar os mods.

PriorityLimit = 100               ; Valor máximo permitido para Profiles.*.Priority (o mínimo é 1).



[Profiles.Default.Config]

IgnoreAllMods  = false            ; Ignora todos os mods. Na prática, desativa completamente o carregamento de mods.

ExcludeAllMods = false            ; Impede o carregamento de todos os mods, exceto aqueles definidos em IncludeMods.



[Profiles.Default.Priority]

; Define a prioridade dos mods quando dois ou mais modificam o mesmo arquivo.
;
; A prioridade deve estar entre 1 e PriorityLimit.
; Valores maiores possuem prioridade sobre valores menores.
;
; Prioridade 0 faz com que o mod seja ignorado
; (equivalente a adicioná-lo em IgnoreMods).
;
; A prioridade padrão é 50.
;
; Exemplo:
; MeuMod=50



[Profiles.Default.IgnoreFiles]

; Adicione aqui arquivos que deverão ser ignorados pelo Mod Loader.
;
; É possível utilizar curingas (*).
;
; Exemplos:
; cheetah.dff
; *.dff
; models/*.txd
; textures/**/*.png



[Profiles.Default.IgnoreMods]

; Adicione aqui os mods que deverão ser ignorados.
;
; Também é possível utilizar curingas (*).

_ignore



[Profiles.Default.IncludeMods]

; Adicione aqui os mods que deverão ser carregados
; quando ExcludeAllMods estiver definido como true.



[Profiles.Default.ExclusiveMods]

; Adicione aqui os mods que deverão ser carregados
; exclusivamente neste perfil.
;
; Esses mods serão ignorados automaticamente por todos
; os demais perfis.
