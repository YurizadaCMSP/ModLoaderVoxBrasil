;
;           Arquivo de Configuração Básica do Mod Loader
;                 Tradução PT-BR - VoxBrasil
;

[Config]

EnableMenu        = true        ; Ativa ou desativa o menu do Mod Loader (Menu > Opções > Mod Loader)

EnablePlugins     = true        ; Ativa ou desativa os plugins localizados em "modloader/.data/plugins". É recomendado mantê-los ativados, pois são responsáveis pelo carregamento dos mods.

EnableLog         = true        ; Ativa ou desativa o arquivo de registro (log). O log é útil para identificar erros e acompanhar o funcionamento do Mod Loader, porém pode reduzir levemente o desempenho do jogo.

ImmediateFlushLog = true        ; Ativa ou desativa a gravação imediata do log no disco. Desativar essa opção melhora o desempenho quando o log está habilitado, mas aumenta o risco de perda de informações em caso de travamento.

MaxLogSize        = 5242880     ; Tamanho máximo do arquivo "modloader.log" em bytes. Ao atingir esse limite, o arquivo será automaticamente recriado.

AutoRefresh       = true        ; Detecta automaticamente alterações na pasta "modloader/" e recarrega os mods sem a necessidade de reiniciar o jogo.
